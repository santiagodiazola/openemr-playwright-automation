{
  "name": "openemr-playwright-automation",
  "version": "1.0.0",
  "description": "Production-grade Playwright framework targeting OpenEMR web applications.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "keywords": ["playwright", "testing", "automation", "openemr", "typescript"],
  "author": "Santiago Díaz Ola",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-plugin-playwright": "^1.5.0",
    "prettier": "^3.2.5"
  }
}